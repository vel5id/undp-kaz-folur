{
  "hosting": {
    "public": "site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/bathymetry-training-80k.csv",
      "**/lesson-bathymetry-tracks.csv",
      "**/lesson-shore-synthetic.csv",
      "**/SECRET-origin.json",
      "**/bathymetry-grid-100m.tfw",
      "**/bathymetry-grid-100m.tif",
      "**/bathymetry-training-set.csv",
      "**/private-datasets/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(csv|ipynb|pdf|tif|tfw|zip)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/python-lab/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'self' blob: 'wasm-unsafe-eval' 'sha256-Fn0Lk+z/DyEX7WbBIT7h4xiDhKuz7arTlZ/IhqbfaKI='; worker-src blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), usb=(), serial=(), payment=()"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/files/bathymetry-training-80k.csv",
        "destination": "https://zenodo.org/records/23014446/files/bathymetry-training-80k.csv?download=1",
        "type": 301
      }
    ]
  }
}
